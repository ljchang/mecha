root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,yml,yaml,css,md,mdx}]
indent_size = 2

[*.py]
indent_size = 4

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab

# Markdown uses trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false
