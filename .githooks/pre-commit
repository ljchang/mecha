#!/bin/bash
# Refuse a commit that CI's rustfmt job would reject.
#
# This exists because the rule already existed and did not hold. CONTRIBUTING
# has said "run cargo fmt --all before pushing" since the beginning, CI has had
# a rustfmt job the whole time, and between v0.1.3 and v0.1.4 the tree still
# drifted 105 sites across 20 files — four commits landed red and stayed red,
# because a failing job nobody is watching is not a gate.
#
# Worth being precise about what went wrong, since it decides what the fix is:
# v0.1.3 is fmt-clean under the same rustfmt that found those 105 sites, so
# this was never a toolchain-version problem and a rust-toolchain.toml would
# have fixed nothing. (It would also have broken something: CI's test matrix is
# `rust: [stable, "1.89"]`, and a pinned toolchain file overrides the action's
# choice, so the MSRV job would have quietly started testing stable twice.)
# The drift was ordinary unformatted commits, and the earliest place to catch
# those is here, before the commit exists.
#
# `--all` rather than only the staged files: it is exactly what CI runs, and a
# hook that checks something narrower can pass while CI fails, which is worse
# than no hook. It is cheap on a warm target dir.
#
# Deliberately not a fixer. A hook that reformats behind you commits code you
# have not read, and staged-vs-working-tree divergence during a partial commit
# is a genuinely confusing way to lose work. It reports and refuses.
#
# `git commit --no-verify` skips it, which is correct for a WIP commit on a
# branch — CI is still the actual gate.

if ! command -v cargo >/dev/null 2>&1; then
    exit 0  # No toolchain here (a docs-only container, say). Not this hook's business.
fi

if ! cargo fmt --all --check >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt --all --check fails — CI's rustfmt job would reject this."
    echo
    cargo fmt --all --check 2>&1 | grep '^Diff in' | sed 's/^/  /' | sort -u | head -20
    n=$(cargo fmt --all --check 2>&1 | grep -c '^Diff in')
    echo
    echo "  $n site(s) to fix. Run:  cargo fmt --all"
    echo "  Intentional (WIP branch)? Commit with --no-verify."
    exit 1
fi
