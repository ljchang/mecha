#!/bin/bash
# Refuse to push a persona chat's or a voice call's words (owner's ruling,
# 2026-10-04): the same check as pre-commit, over every commit being pushed,
# so a `--no-verify` commit is still caught before it is public.
# `scripts/check-private.py` holds the reasoning.
command -v python3 >/dev/null 2>&1 || exit 0
[ -f scripts/check-private.py ] || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a deletion pushes no text
    if [ "$remote_sha" = "$zero" ]; then
        # A new branch: everything not already on the remote's main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
        [ -n "$base" ] || continue
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    python3 scripts/check-private.py --range "$range" || status=1
done
exit $status
