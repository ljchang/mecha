#!/bin/bash
# Refuse to push a persona chat's or a voice call's words (owner's ruling,
# 2026-10-04): the same check as pre-commit, over every commit being pushed,
# so a `--no-verify` commit is still caught before it is public.
# `scripts/check-private.py` holds the reasoning.
#
# Fails closed (review of #557): a range that cannot be worked out is
# refused, never skipped — a skipped push reads exactly like a passed one.
command -v python3 >/dev/null 2>&1 || exit 0
[ -f scripts/check-private.py ] || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a deletion pushes no text
    base=""
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        # A new branch, or a remote tip this clone has never fetched: the
        # commits no remote has yet, and the parent of the oldest of them.
        oldest=$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null | head -1)
        if [ -z "$oldest" ]; then
            continue                                # every commit is already on a remote
        fi
        base=$(git rev-parse --verify --quiet "$oldest^") || base=""
    fi
    if [ -z "$base" ]; then
        echo "check-private: cannot tell what $local_ref adds (no base commit); refusing the push."
        echo "  Fetch first, or push with --no-verify if you have checked it yourself."
        status=1
        continue
    fi
    python3 scripts/check-private.py --range "$base..$local_sha" || status=1
done
exit $status
