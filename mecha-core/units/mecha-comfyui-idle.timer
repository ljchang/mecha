# Runs the idle reset beside mecha's image server every minute; rendered and
# installed with it (mecha-core/src/comfyui_unit.rs).

[Unit]
Description=Check every minute whether @UNIT@ is holding memory idle

[Timer]
OnBootSec=5min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
