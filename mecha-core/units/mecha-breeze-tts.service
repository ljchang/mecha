# mecha's speech engine, as `mecha features enable voice` installs it
# (mecha-core/src/speech_unit.rs): qwentts.cpp with Breeze TTS 2, built from
# the pinned commit of github.com/ljchang/qwentts.cpp. Rendered at install:
# the placeholders become absolute paths under this mecha home and the port.
# The engine finds its libraries beside it ($ORIGIN), so no library path is
# set here.

[Unit]
Description=mecha speech engine: Breeze TTS 2 on qwentts.cpp (:@ENGINE_PORT@)
After=network.target

[Service]
# `exec`: a missing binary fails the start at once (review of #638).
Type=exec
ExecStart=@DIR@/engine/tts-server --model @DIR@/models/@MODEL@ --codec @DIR@/models/@CODEC@ --host 127.0.0.1 --port @ENGINE_PORT@ --alias breeze-tts2
Restart=on-failure
RestartSec=5
OOMScoreAdjust=300

[Install]
WantedBy=default.target
