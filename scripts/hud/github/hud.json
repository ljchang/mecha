{
  "version": 1,
  "title": "GitHub",
  "datasets": ["headline", "failing_now", "recent_runs", "new_items"],
  "filters": [
    {"id": "owner", "label": "Owner", "dataset": "new_items", "field": "owner"}
  ],
  "panels": [
    {"type": "kpi", "title": "Repositories red", "dataset": "headline", "value": {"op": "max", "field": "failing"}, "span": 1},
    {"type": "kpi", "title": "New in a day", "dataset": "headline", "value": {"op": "max", "field": "new_day"}, "span": 1},
    {"type": "kpi", "title": "New in a week", "dataset": "headline", "value": {"op": "max", "field": "new_week"}, "span": 1},
    {"type": "kpi", "title": "Watched", "dataset": "headline", "value": {"op": "max", "field": "watched"}, "span": 1},
    {"type": "table", "title": "Failing now", "dataset": "failing_now",
     "columns": ["repo", "workflow", "red_since", "days_red", "last_green"], "span": 4},
    {"type": "chart", "title": "Last ten runs", "span": 4,
     "vegalite": {
       "data": {"name": "recent_runs"},
       "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
       "encoding": {
         "x": {"field": "slot", "type": "ordinal", "title": "older → newer", "axis": {"labels": false, "ticks": false}},
         "y": {"field": "repo", "type": "nominal", "title": null},
         "color": {"field": "conclusion", "type": "nominal", "title": null,
                   "scale": {"domain": ["success", "failure", "cancelled", "timed_out", "skipped", "unknown"],
                             "range": ["#3fa66b", "#d6453d", "#9a9a9a", "#e0902f", "#c8c8c8", "#6f6f6f"]}},
         "tooltip": [
           {"field": "repo", "type": "nominal"},
           {"field": "conclusion", "type": "nominal"},
           {"field": "created_at", "type": "temporal"}
         ]
       }
     }},
    {"type": "table", "title": "New: open issues and outside pull requests", "dataset": "new_items",
     "columns": ["repo", "kind", "number", "title", "author", "age_days", "comments"], "span": 4},
    {"type": "text", "span": 4,
     "markdown": "Collected once a day (06:40 Eastern) through your own `gh` login; the headline's dataset carries when the collector last finished. Red means the latest completed run of a workflow on the default branch failed; Dependabot's update runs are not counted. New lists what is open now — an issue opened and closed within a day is never seen. Titles are the authors' own text."}
  ]
}
