# Install: cp scripts/mecha-mail-classify.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable --now mecha-mail-classify.timer
#          loginctl enable-linger "$USER"
#
# The workspace is named explicitly, and it has to be. A user unit with no
# WorkingDirectory runs in `$HOME`, which *contains* `~/.mecha`, and
# `setup::prepare_tools` refuses a workspace the mecha home sits under — it
# would put the mail tokens, every session transcript and the learning store
# inside the path jail. This unit failed exactly that way on first run
# (2026-08-18) before the flag was added; the ruminate unit dodges it by
# resolving its own directory in a wrapper script, and this one has no wrapper.
#
# Note the direction of the check: a workspace *inside* the mecha home is fine
# and is the default for any producer. What is refused is one the mecha home
# sits under. `~/.mecha/work/mail-classify/` is the ordinary producer directory
# every other unattended run gets, and ExecStartPre creates it because a
# workspace that does not exist is not one either.
#
# Do not point this at a checkout. An unattended run must not be handed a
# project's `mecha.toml`, which is the same reason the triggers unit stays out
# of one.
#
# **Why this is a timer and not a `mecha trigger`.** A trigger's action is a
# *prompt*, on purpose — scheduled commands are what cron is for, and giving
# one a home there would mean re-answering how it gets confined and which
# environment it sees. This is a command: a deterministic sweep with no model
# decisions in the driver. Asking a model to call a tool to do what a CLI does
# exactly would be re-answering a settled question badly.
#
# **Both accounts, since 2026-08-25.** This swept `dartmouth` only, because
# the Google client is pinned in Testing publishing status and `personal`'s
# refresh credential dies 7 days after consent. The stated cost was a sweep
# "failing on a dead grant"; the real cost was worse and is now fixed.
# `mail_recent` fans out and a fan-out that loses an account still answers —
# surviving rows plus a trailing plain-text note — and `classify` parsed that
# with `serde_json::from_str`, which rejects the note as trailing characters.
# So one revoked grant failed the sweep for *every* account, including the
# ones that answered. `parse_recent` reads the leading value and reports the
# note, so a lapsed `personal` now costs `personal` and prints why.
#
# That is what makes omitting `--account` safe rather than optimistic: the
# bad night degrades to what this unit already did, instead of to nothing.
# `--limit` is per account.
#
# The lapse is still real and still wants fixing at the root: publishing the
# client to **In production** ends the 7-day expiry, and needs no
# verification and no CASA assessment — those buy the removal of the
# unverified-app screen and the lifetime cap of 100 users, neither of which
# binds a single-user assistant. `accounts.toml` declares
# `grant_lifetime_days = 7`; drop it when the client is published.
#
# A failure needs no log convention of its own: `mecha doctor` globs
# `mecha-*` for failed units, so this one is already watched.

[Unit]
Description=mecha nightly mail triage (classify what arrived)
# Nothing here is worth starting before the network is.
After=network-online.target

[Service]
Type=oneshot
# 50 is the tool's own ceiling. A night that brought fewer costs less; a night
# that brought more leaves the remainder for the next sweep rather than
# silently dropping it, because `classify` skips what the store already knows.
ExecStartPre=/bin/mkdir -p %h/.mecha/work/mail-classify
ExecStart=%h/.cargo/bin/mecha --workspace %h/.mecha/work/mail-classify mail classify --limit 50
# The sweep is model-bound and this host's inference is bandwidth-bound, so a
# run that has somehow not finished by morning is worse than one that stopped:
# it would still be competing with the briefing at 07:00.
TimeoutStartSec=45min
