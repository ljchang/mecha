# Install: cp scripts/mecha-ruminate.{service,timer} ~/.config/systemd/user/
#
# There is deliberately no WorkingDirectory here. A user unit without one runs
# in `$HOME`, which *contains* `~/.mecha`, and the stages that replay against
# the live tool surface refuse a workspace the mecha home sits under. The
# script resolves its own directory instead (`mecha work path ruminate`), so it
# is correct however it is launched rather than only under this unit.
#
# Do not "fix" that by pointing this at a checkout: an unattended run must not
# be handed a project's `mecha.toml`, which is the same reason the triggers
# unit stays out of one.
[Unit]
Description=mecha nightly rumination (reflect, validate, learn)

[Service]
Type=oneshot
# The wrapper runs `mecha` by absolute path, but the graph MCP server mecha
# spawns is resolved by name against *this* PATH (passed through to the
# child). Here the failure would be loud rather than silent: ruminate.sh's
# `mecha distill` connects to the server directly and errors out on a failed
# spawn, so the step announces itself in the dated log while the script (not
# `set -e`) walks on. The same line the slack and triggers units carry
# (found on review).
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/Github/mecha/scripts/ruminate.sh
