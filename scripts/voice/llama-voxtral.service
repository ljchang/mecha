# STT for mecha's voice mode: Voxtral Mini 3B behind llama-server.
# docs/VOICE-RESEARCH.md S7 records the operational rules this encodes:
# the mmproj is load-bearing (a server without it answers fluently that
# it cannot hear), and clients MUST send cache_prompt:false - slot cache
# reuse splices mid-audio and presents as deafness.
#
# Install: sudo cp scripts/voice/llama-voxtral.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now llama-voxtral
[Unit]
Description=llama-server STT for mecha voice (voxtral-mini-3b, :8082)
After=network.target

[Service]
User=ljchang
ExecStart=/home/ljchang/.local/bin/llama-server \
  -m /home/ljchang/models/voxtral/mistralai_Voxtral-Mini-3B-2507-Q8_0.gguf \
  --mmproj /home/ljchang/models/voxtral/mmproj-mistralai_Voxtral-Mini-3B-2507-f16.gguf \
  --host 127.0.0.1 --port 8082 -c 8192 -np 1 -ngl 99
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
