# The Pipecat voice worker: WebRTC page + VAD/STT/TTS pipeline, :7860.
# Deliberately dumb - all judgment is behind the facade (D2).
[Unit]
Description=mecha voice worker (Pipecat, :7860)
After=network.target mecha-voice-serve.service

[Service]
WorkingDirectory=/home/ljchang/Github/mecha
# Fill in the two origins before installing — this repo is public, so the
# real tailnet name lives in docs/OPERATIONS.md (gitignored) rather than
# here. An unedited copy refuses every offer, which is the safe way for
# a placeholder to be wrong.
#
# --allowed-origins closes drive-by voice injection: with open CORS, any
# website in a browser on a tailnet device could post an offer and feed
# synthetic speech into an owner-postured agent. Only the two app origins
# may initiate a call.

# The echo filter's energy floor while mecha's own voice is playing, in RMS.
# It goes *here*, not in a shell: systemd does not inherit a login shell's
# environment, so `export MECHA_VOICE_ECHO_RMS=...` reaches this process not
# at all — and silently, since the worker warns about an invalid value and
# never about an unset one.
#
# The value is a property of this room and this microphone, and the worker
# logs the measurement to set it from:
#
#   journalctl -u mecha-voice-worker -f | grep "parakeet segment gated:"
#
# Measured 2026-09-03 and deliberately still not set. The journal of every
# call in the preceding fortnight carries an RMS per segment and the bot's own
# speaking edges, so each segment can be classified by whether our speaker was
# playing — which is the only population this floor ever judges. Sorted, that
# population is:
#
#   0.0124  ''                                        (silence)
#   0.0141  'The training.'                           <- a real turn
#   0.0201  "What's on my schedule for today?"        <- a real turn
#   0.0257  'The Starlink Mini costs one hundred…'    <- ECHO
#   0.0311  'Yeah.'                                   <- a real turn
#   0.0457 … 0.0774                                   real turns
#
# The echo sits *inside* the speech distribution, between two real barge-ins.
# There is no floor that catches it and keeps them: 0.030 buys that one echo
# and costs the 0.0201 and 0.0141 turns, and turn-start is transcription-based,
# so a gated turn is not a degraded turn but no turn at all.
#
# And the sample is of the wrong machine. Every one of those lines predates
# 2026-09-03 11:09, when the worker first ran with the mic-meter repair — until
# then a WebAudio tap had the browser's echo canceller disarmed, which is what
# 0.0257 of residual echo is a measurement of. A floor set from it would be
# tuned to a fault that no longer exists.
#
# So the slot stays commented, the default (0.020) applies, and the number
# wants re-deriving from a call made *after* that restart. Re-run the
# classification with the bot-speaking edges, not the raw RMS list:
#
#   journalctl -u mecha-voice-worker | grep -E "_bot_(started|stopped)_speaking|parakeet: duration"
#
#Environment=MECHA_VOICE_ECHO_RMS=0.020
ExecStart=/home/ljchang/models/voice-worker-venv/bin/python scripts/voice/worker.py --host 127.0.0.1 --port 7860 --allowed-origins https://YOUR-HOST.YOUR-TAILNET.ts.net https://YOUR-HOST.YOUR-TAILNET.ts.net:8443
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
