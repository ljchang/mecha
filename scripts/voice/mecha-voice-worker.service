# The Pipecat voice worker: WebRTC page + VAD/STT/TTS pipeline, :7860.
# Deliberately dumb - all judgment is behind the facade (D2).
[Unit]
Description=mecha voice worker (Pipecat, :7860)
After=network.target mecha-voice-serve.service

[Service]
WorkingDirectory=/home/ljchang/Github/mecha
# Fill in the two origins before installing — this repo is public, so the
# real tailnet name lives in docs/OPERATIONS.md (gitignored) rather than
# here. An unedited copy refuses every offer, which is the safe way for
# a placeholder to be wrong.
#
# --allowed-origins closes drive-by voice injection: with open CORS, any
# website in a browser on a tailnet device could post an offer and feed
# synthetic speech into an owner-postured agent. Only the two app origins
# may initiate a call.

# The echo filter's energy floor while mecha's own voice is playing, in RMS.
# It goes *here*, not in a shell: systemd does not inherit a login shell's
# environment, so `export MECHA_VOICE_ECHO_RMS=...` reaches this process not
# at all — and silently, since the worker warns about an invalid value and
# never about an unset one.
#
# The value is a property of this room and this microphone, and the worker
# logs the measurement to set it from:
#
#   journalctl -u mecha-voice-worker -f | grep "parakeet segment gated:"
#
# Measured, 2026-09-03, from this room and this microphone — the journal of
# the 2026-09-01 21:35 call, which is the one that prompted the whole echo
# arc. `journalctl -u mecha-voice-worker | grep "parakeet: duration"`:
#
#   echo    0.0257  "The Starlink Mini costs one hundred ninety nine dollars."
#                   (the bot had said "The Starlink Mini costs $199." 13s earlier)
#   echo    0.0418  "It's prose."  (the bot's "Its pros are that it is tiny…")
#   speech  0.0392  "Um options for"        <- the quietest real turn observed
#   speech  0.0396 … 0.1384                 across every call in the window
#
# So 0.030: above the louder of the two echoes' quieter sibling, and below the
# quietest real turn by a 23% margin. It is not a clean separation — 0.0418 of
# echo sits above 0.0392 of speech, and no threshold can split those — which is
# why this is one layer of three rather than the answer. Raising it to catch
# 0.0418 would cost the 0.0392 turn, and a dropped turn is the expensive
# failure: turn-start is transcription-based, so a wrong gate is not a degraded
# turn but no turn at all.
Environment=MECHA_VOICE_ECHO_RMS=0.030
ExecStart=/home/ljchang/models/voice-worker-venv/bin/python scripts/voice/worker.py --host 127.0.0.1 --port 7860 --allowed-origins https://YOUR-HOST.YOUR-TAILNET.ts.net https://YOUR-HOST.YOUR-TAILNET.ts.net:8443
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
