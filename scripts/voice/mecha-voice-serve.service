# The voice facade: mecha behind an OpenAI-compatible endpoint on loopback.
# docs/VOICE-RESEARCH.md D2/D3; user unit on purpose - it runs as the owner
# and needs no privilege. Points at the voice-arc worktree release build
# until the branch merges and the installed binary carries voice-serve.
[Unit]
Description=mecha voice-serve (OpenAI facade for the voice worker, :8990)
After=network.target

[Service]
ExecStart=/home/ljchang/Github/mecha/.claude/worktrees/voice-arc/target/release/mecha voice-serve --port 8990 --yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
