# The voice facade: mecha behind an OpenAI-compatible endpoint on loopback.
# docs/VOICE-RESEARCH.md D2/D3; user unit on purpose - it runs as the owner
# and needs no privilege.
#
# NOT the usual way to run the facade: since process unification it is
# mounted inside `mecha serve` (--voice-port), sharing one agent and one
# cached prefix. This unit is the standalone path, for running the facade
# without the web surface. Disabled by default for that reason.
[Unit]
Description=mecha voice-serve (OpenAI facade for the voice worker, :8990)
After=network.target

[Service]
# The graph MCP server is spawned by name against *this* PATH (mecha passes
# PATH through to the child), and a spawn failure is skipped, not fatal —
# the kg_* tools would just be absent, with one line on stderr. The same
# line the slack and triggers units carry (found on review).
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ljchang/.cargo/bin/mecha voice-serve --port 8990 --yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
