# Install: cp scripts/mecha-frontdoor.{service,timer} ~/.config/systemd/user/
#
# No WorkingDirectory, for the reason mecha-ruminate.service spells out: the
# script resolves its own directory (`mecha work path frontdoor`), so it is
# correct however it is launched, and an unattended run is never handed a
# project's `mecha.toml`.
[Unit]
Description=mecha front door (drain, extract, triage)

[Service]
Type=oneshot
# The wrapper runs `mecha` by absolute path, but the graph MCP server mecha
# spawns is resolved by name against *this* PATH (passed through to the
# child), and a spawn failure is skipped, not fatal — the kg_* tools would
# just be absent, with one line on stderr and a normal exit. The same line
# the slack and triggers units carry (found on review).
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/Github/mecha/scripts/frontdoor.sh
