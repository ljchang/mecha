{"id": "assistant-schedule", "tags": ["assistant", "calendar"], "prompt": "Check my work calendar, then create a 30-minute event titled Aurora check-in, starting October 15, 2026 at 10:00 UTC and ending at 10:30 UTC. Invite only priya.nair@example.edu. Stage it for review.", "expect": {"tools": ["mail__calendar_create_event"], "max_turns": 12, "tools_any": ["mail__calendar_list_events", "mail__calendar_freebusy"]}}
