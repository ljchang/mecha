// Sequential assistant follow-through. The lifetime principal releases only into fixture stores.
{"id": "assistant-reply", "tags": ["assistant", "follow-through", "mail"], "prompt": "Reply to Priya in the Aurora specific aims thread using exactly this wording: Thursday at 3pm works for me. Please bring the tracked-changes version. Stage it for my review.", "expect": {"tools": ["mail__mail_reply"], "forbid_tools": ["mail__mail_send"], "max_turns": 10}}
