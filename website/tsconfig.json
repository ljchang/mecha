// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  // Static assets include the already-built web demo and factory gallery.
  // Their source is checked in their own projects; render-check runs the demo.
  "exclude": [".docusaurus", "build", "static"]
}
